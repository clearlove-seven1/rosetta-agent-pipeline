# OpenAI compatible API
# 大模型配置 (支持第三方 API 或本地 Ollama/vLLM)
LLM_MODEL="填入你的模型名称，例如 grok-4-1 或 qwen2.5:32b"
LLM_API_KEY="填入你的 API KEY，如果用本地 Ollama 填 ollama 即可"
LLM_BASE_URL="填入你的 API 接口地址，例如 https://api.shubiaobiao.cn/v1 或 http://127.0.0.1:11434/v1"


# Rosetta paths
ROSETTA_BIN_DIR=/path/to/rosetta/source/bin

ROSETTA_SCRIPTS_DIR=/path/to/rosetta/source/scripts/python/public

PYMOL_BIN=/path/to/pymol
